# ---- storage ----
# sqlite (default, zero setup) or supabase
DATABASE_MODE=sqlite
SQLITE_PATH=data/tracker.db
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- scraping ----
# false = no automatic Home Depot scrapes; enter prices by hand in the dashboard or with
# `python -m tracker price`. Home Depot currently blocks the scraper, so false is the safe choice.
SCRAPE_ENABLED=false
# where collected prices come from: hd_direct (blocked by Akamai), licensed_api, sample, mock
# sample and mock are made-up data for development: never real prices
PRICE_PROVIDER=hd_direct
# licensed_api only: vendor key and base URL (keep the key here, never in code)
PRICE_API_KEY=
PRICE_API_URL=
# seconds between licensed_api requests, as the vendor's plan allows
PRICE_API_MIN_INTERVAL=1
# the vendor plan's own request limits (0 = none; the COLLECTOR_ limits below still apply)
PRICE_API_MAX_PER_MINUTE=0
PRICE_API_MAX_PER_DAY=0
# what the vendor was VERIFIED to provide, comma separated, from:
# store_level_price, clearance_price, inventory, sku_lookup   (leave empty until verified)
PRICE_API_CAPABILITIES=
# true only if the vendor's terms allow keeping their responses for a while
PRICE_API_CACHE_ALLOWED=false

# ---- collector ----
# request budget per provider; the stricter of this and the provider's own limit wins (0 = none)
COLLECTOR_MAX_PER_MINUTE=30
COLLECTOR_MAX_PER_DAY=2000
# minutes a cached answer is reused (only for providers that allow caching; 0 = off)
COLLECTOR_CACHE_TTL_MINUTES=60
# observations above this price, or older than this many days, are rejected
COLLECTOR_MAX_PRICE=50000
COLLECTOR_MAX_AGE_DAYS=30
# mock provider responses (default: tracker/providers/fixtures/mock_responses.json)
MOCK_PROVIDER_FILE=
# seconds between requests (random between MIN and MAX)
REQUEST_DELAY_MIN=2
REQUEST_DELAY_MAX=4
# run the browser headless (set false the first time if the bot check wants to see a window)
HEADLESS=true
# hours between full scrapes
SCRAPE_EVERY_HOURS=4
# local hour (24h) for the daily community-list refresh
COMMUNITY_HOUR=7
# max community items watched at once (each one = 1 request per store per scrape)
COMMUNITY_MAX=60
TIMEZONE=America/New_York

# ---- alerts ----
ALERT_THRESHOLD=70
WATCH_THRESHOLD=45

# ---- API (/v1) ----
# name:key pairs, comma separated. Keys must be at least 16 characters; make them random:
#   PowerShell: -join ((48..57)+(97..122) | Get-Random -Count 40 | % {[char]$_})
#   Linux/macOS: openssl rand -hex 24
# Empty = the /v1 API answers 503 (except /v1/health). The dashboard does not need a key.
API_KEYS=

# ---- dashboard ----
WEB_HOST=0.0.0.0
WEB_PORT=8000
