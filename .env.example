# ---- storage ----
# sqlite (default, zero setup) or supabase
DATABASE_MODE=sqlite
SQLITE_PATH=data/tracker.db
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- scraping ----
# false = no automatic Home Depot scrapes; enter prices by hand in the dashboard or with
# `python -m tracker price`. Home Depot currently blocks the scraper, so false is the safe choice.
SCRAPE_ENABLED=false
# where scraped prices come from: hd_direct (blocked by Akamai), licensed_api, sample
PRICE_PROVIDER=hd_direct
# licensed_api only: vendor key and base URL (keep the key here, never in code)
PRICE_API_KEY=
PRICE_API_URL=
# seconds between licensed_api requests, as the vendor's plan allows
PRICE_API_MIN_INTERVAL=1
# seconds between requests (random between MIN and MAX)
REQUEST_DELAY_MIN=2
REQUEST_DELAY_MAX=4
# run the browser headless (set false the first time if the bot check wants to see a window)
HEADLESS=true
# hours between full scrapes
SCRAPE_EVERY_HOURS=4
# local hour (24h) for the daily community-list refresh
COMMUNITY_HOUR=7
# max community items watched at once (each one = 1 request per store per scrape)
COMMUNITY_MAX=60
TIMEZONE=America/New_York

# ---- alerts ----
ALERT_THRESHOLD=70
WATCH_THRESHOLD=45

# ---- dashboard ----
WEB_HOST=0.0.0.0
WEB_PORT=8000
