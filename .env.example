# ---- storage ----
# sqlite (default, zero setup) or supabase
DATABASE_MODE=sqlite
SQLITE_PATH=data/tracker.db
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- scraping ----
# seconds between requests (random between MIN and MAX)
REQUEST_DELAY_MIN=2
REQUEST_DELAY_MAX=4
# run the browser headless (set false the first time if the bot check wants to see a window)
HEADLESS=true
# hours between full scrapes
SCRAPE_EVERY_HOURS=4
# local hour (24h) for the daily community-list refresh
COMMUNITY_HOUR=7
# max community items watched at once (each one = 1 request per store per scrape)
COMMUNITY_MAX=60
TIMEZONE=America/New_York

# ---- alerts ----
ALERT_THRESHOLD=70
WATCH_THRESHOLD=45

# ---- dashboard ----
WEB_HOST=0.0.0.0
WEB_PORT=8000
